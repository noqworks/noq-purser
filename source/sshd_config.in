# NOQ Purser gate: a separate sshd that only lets the box in, only with its key, only to the
# forced command. Rendered to /etc/purser/sshd_config by purser-admit; the main sshd is untouched.
ListenAddress @LISTEN@:@PORT@
HostKey /etc/purser/ssh/ssh_host_ed25519_key
PidFile /run/purser-sshd.pid
AllowUsers @ALLOW@
AuthorizedKeysFile /etc/purser/ssh/authorized_keys
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no
# No ForceCommand: every key line (written only by purser-admit, root-owned file) carries its own
# command="@PREFIX@/sbin/purser-gate <box id>" with "restrict"; the one-time pairing key runs "--pair".
PermitTTY no
DisableForwarding yes
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
MaxAuthTries 2
MaxSessions 2
MaxStartups 4:50:10
LoginGraceTime 20
ClientAliveInterval 30
ClientAliveCountMax 4
HostKeyAlgorithms ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519
KexAlgorithms @KEX@
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
LogLevel VERBOSE
SyslogFacility AUTH
