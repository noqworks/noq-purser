# NOQ Purser: first boot settings. Normally image/purser-setup writes this file onto the card's
# setup partition (PURSERSET) together with the one-time secrets; it is shown here for reference
# and for image/build-image.sh --setup-conf (an image for many boxes: no BOX_ID, no PREPARE_DISK).
# The box reads it once at first boot, writes /etc/purser/purser.conf from it and erases it.
# Pairing with the server is not set here: "purser pair" on the server, QR code on the box page.

BOX_ID="K7RT"                    # 4 characters A-Z/2-9 without I L O; empty = the box picks one
LANG_UI="en"                     # en | tr
TZ="Europe/Istanbul"             # display only; generation ids are UTC

# --- network (wired only) ---
NET_ADDRESS=""                   # empty = DHCP; or e.g. "192.168.2.200/24"
NET_GATEWAY=""
NTP_SERVERS="gateway"            # gateway = the router; or addresses. No internet pool by default.
DNS_SERVERS=""                   # empty: the box needs no name resolution

# --- light (NeoPixel stick on SPI) ---
LIGHT_KIND="rgbw"                # rgbw | rgb
LIGHT_BRIGHTNESS="0.35"

# --- disk: erased and prepared only when this equals BOX_ID (purser-setup asks you to type it);
#     needs recovery.once (the passphrase you wrote on paper) next to this file ---
# PREPARE_DISK="K7RT"
