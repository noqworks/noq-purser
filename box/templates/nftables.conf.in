#!/usr/sbin/nft -f
# NOQ Purser box firewall (rendered by "purser apply-config" from purser.conf).
# Nothing comes in. Out: the server gate (one address, one port), the two configured DNS
# resolvers, NTP, DHCP, and HTTPS only to the addresses of the notification host, which the
# core re-resolves into @bildirim before every send.
flush ruleset
table inet purser {
  set bildirim { type ipv4_addr; }
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    udp sport 67 udp dport 68 accept
    @MAINT_SSH_RULE@
  }
  chain output {
    type filter hook output priority 0; policy drop;
    oif lo accept
    ct state established,related accept
    ip daddr @SERVER@ tcp dport @SERVER_PORT@ accept
    ip daddr { @DNS_SERVERS@ } meta l4proto { tcp, udp } th dport 53 accept
    udp dport 123 accept
    udp sport 68 udp dport 67 accept
    ip daddr @bildirim tcp dport 443 accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
}
