#!/usr/sbin/nft -f
# NOQ Purser box firewall (rendered by "purser apply-config" from purser.conf).
# Nothing comes in. Out: the server gate (one address, one port), the configured DNS resolvers,
# NTP and DHCP. The maint_in / maint_out chains are filled by purser-maint only while the
# maintenance switch is on (the local subnet may reach the page and SSH), and emptied when it is off.
flush ruleset
table inet purser {
  chain maint_in { }
  chain maint_out { }
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    udp sport 67 udp dport 68 accept
    jump maint_in
  }
  chain output {
    type filter hook output priority 0; policy drop;
    oif lo accept
    ct state established,related accept
    @SERVER_RULE@
    @DNS_RULE@
    udp dport 123 accept
    udp sport 68 udp dport 67 accept
    jump maint_out
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
  }
}
