# NOQ Purser (rendered by "purser apply-config"). Time comes from the local router (or the
# addresses in NTP_SERVERS), never from the protected server and never from the internet unless
# NTP_POOL is set. The boot service writes /run/purser/chrony.d/step.conf: the board has no
# battery clock, so chrony may step during its first updates only, then refuses large changes.
@NTP_SERVER_LINES@driftfile /var/lib/chrony/chrony.drift
include /run/purser/chrony.d/*.conf
logchange 1
