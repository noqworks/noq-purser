# NOQ Purser (rendered by "purser apply-config"). Time comes from the router and/or a public
# pool, never from the protected server. The boot service writes /run/purser/chrony.d/step.conf:
# the board has no battery clock, so chrony may step during its first updates only, then refuses large changes.
@NTP_SERVER_LINES@pool @NTP_POOL@ iburst maxsources 3
driftfile /var/lib/chrony/chrony.drift
include /run/purser/chrony.d/*.conf
logchange 1
