#!/bin/bash
# NOQ Purser: owns the output lines (relay, green LED, red LED).
#   FIFO commands: "relay 0|1" (1 = disk energized; RELAY_ACTIVE_LOW is applied here).
#   LED pattern:   $RUN_DIR/led contains green | red | red-blink | both | off.
# The relay is off whenever this service starts.
set -euo pipefail
PURSER_LIB=${PURSER_LIB:-/usr/local/lib/purser}
# shellcheck source=lib/common.sh
. "$PURSER_LIB/common.sh"
# shellcheck source=lib/hw.sh
. "$PURSER_LIB/hw.sh"
load_config
: "${RELAY_LINE:?}" "${LED_G_LINE:?}" "${LED_R_LINE:?}"

off=0; [ "$RELAY_ACTIVE_LOW" = 1 ] && off=1
mode=$(gpio_mode)
install -d -m 0700 "$RUN_DIR"
rm -f "$GPIO_FIFO"; mkfifo -m 0600 "$GPIO_FIFO"
exec 3<>"$GPIO_FIFO"

if [ "$mode" = sysfs ]; then
  sysfs_out() {   # sysfs_out <line> <value>
    local n=$(( GPIO_BASE + $1 )) d
    d=/sys/class/gpio/gpio$n
    [ -d "$d" ] || { echo "$n" > /sys/class/gpio/export; sleep 0.2; }
    if [ "$(cat "$d/direction")" = out ]; then echo "$2" > "$d/value"
    elif [ "$2" = 1 ]; then echo high > "$d/direction"
    else echo low > "$d/direction"; fi
  }
  put() { sysfs_out "$1" "$2"; }
else
  coproc GPIOSET { exec gpioset --interactive -c "$GPIO_CHIP" "$RELAY_LINE=$off" "$LED_G_LINE=0" "$LED_R_LINE=0"; }
  put() { printf 'set %s=%s\n' "$1" "$2" >&"${GPIOSET[1]}"; }
fi
put "$RELAY_LINE" "$off"; put "$LED_G_LINE" 0; put "$LED_R_LINE" 0

phase=0; shown=""
while :; do
  if read -r -t 0.5 cmd arg <&3; then
    case "$cmd $arg" in
      "relay 1") put "$RELAY_LINE" $(( 1 - off )) ;;
      "relay 0") put "$RELAY_LINE" "$off" ;;
    esac
  fi
  want=$(cat "$RUN_DIR/led" 2>/dev/null || echo off)
  phase=$(( 1 - phase ))
  [ "$want" = red-blink ] || [ "$want" != "$shown" ] || continue
  case $want in
    green) put "$LED_G_LINE" 1; put "$LED_R_LINE" 0 ;;
    red) put "$LED_G_LINE" 0; put "$LED_R_LINE" 1 ;;
    red-blink) put "$LED_G_LINE" 0; put "$LED_R_LINE" "$phase" ;;
    both) put "$LED_G_LINE" 1; put "$LED_R_LINE" 1 ;;
    *) put "$LED_G_LINE" 0; put "$LED_R_LINE" 0 ;;
  esac
  shown=$want
done
