# NOQ Purser box configuration (/etc/purser/purser.conf). No secrets here: keys live in
# /etc/purser/sirlar and /etc/purser/ssh. After editing run "purser apply-config" (firewall,
# chrony, timer). The file is sourced: keys an older release wrote and this one no longer uses
# are ignored.

# --- server gate: written by pairing ("purser pair" on the server, QR or line on the box page) ---
SERVER=""                     # IPv4 address of the protected server's gate
SERVER_PORT="2222"
SERVER_USER="purser"
# Sources inside each generation, sent by the server at pairing: type:directory[:prune days]
#   type: pgbackrest | borg | restic | dir     prune days: "any" or ISO weekdays "7" / "6,7"
KINDS=""

# --- window ---
NIGHT_AT="05:15"              # first question to the server
POLL_UNTIL="08:30"            # stop asking
POLL_EVERY="300"
MAX_MIN="80"                  # window ceiling in minutes (remote setups: raise it)
LONG_DOW="7"                  # weekly/monthly copies are cut from the first generation on/after this weekday
# PRUNE_DOW="7"               # default prune day for borg/restic/pgbackrest deletions

# --- retention and signals ---
KEEP_DAILY="14"
KEEP_WEEKLY="8"
KEEP_MONTHLY="12"
WARN_FACTOR="3"               # transfer above N x the weekday median: warning
STALE_NIGHTS="2"              # source unchanged for N nights: warning
LATE_H="30"                   # last sound generation older than N hours: alarm
# MASS_DELETE_PCT="50"  MASS_CHANGE_PCT="50"  MASS_MIN_FILES="20"  LABEL_MAX_DAYS="2"
# DISK_MIN_FREE_PCT="10"
# LONG_MIN_NIGHTS="4"  MONTHLY_MIN_WEEKS="3"   (retention counts nights, never trusts dates)

# --- disk ---
LUKS_UUID=""                  # set by setup
MNT="/srv/purser"
STATE="/var/lib/purser"

# --- language (alarms travel to the server as notes; no notification service) ---
LANG_UI="en"                  # en | tr

# --- network and time: the box never goes to the internet ---
DNS_SERVERS=""                # empty: no DNS at all (the box only uses addresses)
NTP_SERVERS="gateway"         # "gateway" = the local router; or addresses, e.g. "192.0.2.1"
NTP_POOL=""                   # a public pool only if you want one (needs DNS and internet)
CLOCK_JUMP_MAX="600"

# --- hardware (board + USB-SATA cable + disk; see docs/hardware.md) ---
BOARD_LED="auto"              # auto | none | a name under /sys/class/leds (e.g. "green:status")
LIGHT_KIND="rgbw"             # the 8-LED stick: rgbw (SK6812) | rgb (WS2812B)
LIGHT_BRIGHTNESS="0.35"       # 0.02 .. 1
MAINT_GPIO="300b000.pinctrl:75"   # maintenance switch: pin controller label : line (PC11, header pin 12)
SERIAL_TTY="ttyS0"            # the debug UART the restricted console runs on
# DISK_WAIT="60"              # seconds to wait for the disk (and again after a USB reset)
